{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://micro-headless-cms.local/schemas/template.schema.json",
  "title": "Micro Headless CMS Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "enum": ["template", "theme"]
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "previewImage": {
      "type": "string",
      "description": "Safe relative path to a preview image, e.g. \"./preview.png\"."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "bgColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "fontFamily": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9 ,\"'_\\-]+$"
        },
        "layoutStyle": {
          "type": "string",
          "enum": ["default", "boxed", "wide", "centered"]
        },
        "mode": {
          "type": "string",
          "enum": ["light", "dark"]
        }
      }
    }
  }
}
