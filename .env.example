# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/thoth?schema=public"

# ============================================
# Application URLs
# ============================================
# Marketplace URL (public catalogue of modules/templates for sale).
# Used by the public homepage link and editable in /admin/marketplace (SiteConfig.marketplaceUrl).
NEXT_PUBLIC_MARKETPLACE_URL=""

# NOTE: the decoupled public web app lives in apps/web and has its own env —
# see apps/web/.env.example (NEXT_PUBLIC_THOTH_API_URL).

# ============================================
# Extensions Configuration
# ============================================
# Enable/disable write operations to extensions directory
# Required for both ZIP upload and install-from-URL (filesystem install)
EXTENSIONS_WRITE_ENABLED="false"

# Optional comma-separated allowlist of hosts permitted for install-from-URL.
# Listed hosts bypass the public-https/private-IP guard (use for trusted internal
# artifact servers only). Example: EXTENSIONS_ALLOWED_HOSTS="artifacts.example.com"
EXTENSIONS_ALLOWED_HOSTS=""

# ============================================
# Templates Configuration
# ============================================
# Enable/disable write operations to templates directory
# Required for both ZIP upload and install-from-URL (filesystem install)
TEMPLATES_WRITE_ENABLED="false"

# Note: install-from-URL for templates reuses EXTENSIONS_ALLOWED_HOSTS
# as its host allowlist for trusted internal artifact servers.

# ============================================
# Media Storage (Optional)
# ============================================
# Storage driver: 'local' (default), 's3', or 'r2'
STORAGE_DRIVER="local"

# Base URL under which local uploads are served (relative to the app origin)
LOCAL_UPLOAD_URL_BASE="/uploads"

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...)
# Required when STORAGE_DRIVER is 's3' or 'r2'. Variables below use the S3_* names
# the code actually reads (this is NOT AWS_*).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Optional public base URL for stored assets (e.g. a CDN).
# Defaults to {S3_ENDPOINT}/{S3_BUCKET} when empty.
S3_PUBLIC_URL_BASE=""

# ============================================
# Security & Authentication
# ============================================
# REQUIRED: session cookies are HMAC-signed with this secret.
# Generate a fresh random value before production: openssl rand -hex 32
# IMPORTANT: leave blank here on purpose — do not ship/share a static sample value.
SESSION_SECRET=""

# CORS allowlist for cross-origin API clients (exact origins, comma-separated).
# No wildcard support on purpose. Leave empty to disable cross-origin access.
# Example: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=""

# Bearer secret for POST /api/admin/automation/cron.
# Endpoint fails closed (401 for every request) while unset.
AUTOMATION_CRON_SECRET=""

# REQUIRED for storing API keys (e.g. automation config). 32-byte hex.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# Optional upload rate limiting (in-memory, per process).
# Max upload requests per user/IP within the window. 0 disables.
UPLOAD_RATE_LIMIT_MAX="30"
UPLOAD_RATE_LIMIT_WINDOW_MS="60000"

# Optional login brute-force protection (in-memory, per process).
# Two buckets per attempt: per source IP and per username.
# 0 disables that bucket.
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_ACCOUNT_LIMIT_MAX="5"
LOGIN_ACCOUNT_LIMIT_WINDOW_MS="900000"

# ============================================
# Docker Compose (Optional)
# ============================================
# PostgreSQL password for docker-compose.yml — REQUIRED for production.
# Generate a URL-safe password (hex avoids '/' which breaks PostgreSQL URLs):
#   openssl rand -hex 24
# Leave blank for local dev only (docker-compose will fail if unset).
POSTGRES_PASSWORD=""