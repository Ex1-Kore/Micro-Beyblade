# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ห้าม commit ค่าจริงเด็ดขาด (ยกเว้นตัวอย่าง)
.env*
!.env.example

# uploaded media (user content — ห้าม commit)
/public/uploads/

# extension install staging (transient)
/tmp/

# logs
*.log

# windows junk
desktop.ini

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace apps (own manifests / build artifacts)
apps/*/node_modules
apps/*/.next/
apps/*/out/
apps/*/.vercel
